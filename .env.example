MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_username
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=your_database
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL
MYSQL_CONNECT_TIMEOUT=10

# Compatibility (Issue #31, for MySQL 5.7)
MYSQL_AUTH_PLUGIN=mysql_native_password
MYSQL_USE_PURE=false
MYSQL_RAISE_ON_WARNINGS=false
# ---- 传输（默认 stdio）----
MCP_TRANSPORT=stdio
# MCP_TRANSPORT=sse
MCP_SSE_HOST=0.0.0.0
MCP_SSE_PORT=8000
# SSE DNS rebinding 防护的 Host 白名单（逗号分隔）
# MCP_SSE_ALLOWED_HOSTS=localhost:8000,192.168.1.10:8000

# ---- 管理页面 ----
# 局域网访问管理 API 所需令牌（不设则仅回环可访问）
# ADMIN_TOKEN=change-me

# ---- 查询执行 ----
# 单次查询返回行数上限（0 不限）
MYSQL_MCP_MAX_ROWS=500
# 语句超时秒数（0 不限；可被每别名 query_timeout 覆盖）
MYSQL_MCP_QUERY_TIMEOUT=60
# 连接池大小（0 禁用；可被每别名 pool_size 覆盖）
MYSQL_MCP_POOL_SIZE=3

# ---- 日志 ----
# 读操作也记审计（默认只记写操作）
# MYSQL_MCP_AUDIT_READ=false
# 执行错误日志保留天数（0 永久）
MYSQL_MCP_ERROR_RETENTION_DAYS=90

# ---- 配置目录（多库模式 databases.json 所在目录）----
# MYSQL_MCP_CONFIG_DIR=./config
